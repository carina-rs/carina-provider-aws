# AWS Organizations Account
#
# Creates a member account in the current organization.

provider aws {
  region = aws.Region.ap_northeast_1
}

aws.organizations.Account {
  account_name               = 'carina-example-member'
  email                      = 'carina-example@example.com'
  iam_user_access_to_billing = aws.organizations.Account.IamUserAccessToBilling.deny
  role_name                  = 'OrganizationAccountAccessRole'

  tags = {
    Environment = 'example'
  }
}
