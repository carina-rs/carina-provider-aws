# ACM Certificate
#
# Requests and validates an ACM certificate with Route 53.

provider aws {
  region = aws.Region.us_east_1
}

let cert = aws.acm.Certificate {
  # CloudFront viewer certificates must be requested in us-east-1.
  # cert_issued waits for issuance; downstream resources should use cert_issued.arn.
  # cert.arn skips that wait. No CertificateValidation resource is needed.
  domain_name       = 'registry.example.com'
  # DNS validation returns the CNAME published by validation_record below.
  validation_method = aws.acm.Certificate.ValidationMethod.dns

  tags = {
    Environment = 'example'
  }
}

let validation_record = aws.route53.RecordSet {
  # Replace this placeholder with the hosted zone ID for the domain.
  hosted_zone_id   = 'Z123EXAMPLE'
  # Publish the DNS challenge returned by ACM.
  name             = cert.domain_validation_options[0].resource_record.name
  type             = cert.domain_validation_options[0].resource_record.type
  ttl              = 60
  resource_records = [cert.domain_validation_options[0].resource_record.value]
}

let cert_issued = wait cert {
  until      = cert.status == 'ISSUED'
  depends_on = [validation_record]
  timeout    = 75min
}
