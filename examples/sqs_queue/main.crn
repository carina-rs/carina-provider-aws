provider aws {
  region = aws.Region.ap_northeast_1
}

aws.sqs.Queue {
  queue_name               = 'carina-example-queue'
  visibility_timeout       = 60
  message_retention_period = 86400

  tags = {
    Environment = 'example'
  }
}

aws.sqs.Queue {
  queue_name                  = 'carina-example-queue.fifo'
  fifo_queue                  = true
  content_based_deduplication = true
  deduplication_scope         = aws.sqs.Queue.DeduplicationScope.message_group
  fifo_throughput_limit       = aws.sqs.Queue.FifoThroughputLimit.per_message_group_id
}
