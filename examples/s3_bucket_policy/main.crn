# S3 Bucket Policy
#
# Denies all S3 actions over insecure transport for a bucket and its objects.

provider aws {
  region = aws.Region.ap_northeast_1
}

let bucket = aws.s3.Bucket {
  bucket = 'carina-example-policy-bucket'

  tags = {
    Environment = 'example'
  }
}

aws.s3.BucketPolicy {
  bucket = bucket.bucket

  policy = {
    version = aws.iam.PolicyDocument.Version.2012_10_17
    statement {
      sid    = 'DenyInsecureTransport'
      effect = aws.iam.PolicyDocument.Statement.Effect.deny

      principal = {
        aws = '*'
      }

      action   = 's3:*'
      resource = [
        bucket.arn,
        "${bucket.arn}/*",
      ]

      condition = {
        bool = {
          'aws:SecureTransport' = 'false'
        }
      }
    }
  }
}
