# IAM Roles data source
#
# `aws.iam.Roles` wraps `iam:ListRoles` and returns parallel
# `arns` / `names` lists of every matched role. Both inputs are
# optional and stack: `path_prefix` is applied server-side, then
# `name_regex` is applied client-side over the union of pages.
#
# The canonical use case (carina-rs/infra#52) is looking up the
# materialized IAM role for an IAM Identity Center permission set,
# whose name suffix is generated by AWS and cannot be discovered
# through any SSO Admin API.

provider aws {
  region = aws.Region.ap_northeast_1
}

let sso_admin_roles = read aws.iam.Roles {
  path_prefix = '/aws-reserved/sso.amazonaws.com/'
  name_regex  = '^AWSReservedSSO_AdministratorAccess_[0-9a-f]{16}$'
}

# Downstream resources consume the result via `sso_admin_roles.arns`
# and `sso_admin_roles.names`. For example, a cross-account
# `aws.s3.BucketPolicy` Principal can be built as
# `sso_admin_roles.arns[0]` once the regex narrows the match to one role.
