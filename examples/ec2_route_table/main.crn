# EC2 Route Table
#
# Creates a route table within a VPC.

provider aws {
  region = aws.Region.ap_northeast_1
}

let vpc = aws.ec2.Vpc {
  cidr_block = '10.0.0.0/16'

  tags = {
    Environment = 'example'
  }
}

aws.ec2.RouteTable {
  vpc_id = vpc.vpc_id

  tags = {
    Environment = 'example'
  }
}
