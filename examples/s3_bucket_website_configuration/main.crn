# S3 Bucket Website Configuration
#
# Configures index and error documents for static website hosting.

provider aws {
  region = aws.Region.ap_northeast_1
}

let bucket = aws.s3.Bucket {
  bucket = 'carina-example-website-bucket'

  tags = {
    Environment = 'example'
  }
}

aws.s3.BucketWebsiteConfiguration {
  bucket = bucket.bucket

  index_document = {
    suffix = 'index.html'
  }

  error_document = {
    key = 'error.html'
  }
}
