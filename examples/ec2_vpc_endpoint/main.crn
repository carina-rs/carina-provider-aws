# EC2 VPC Endpoint
#
# Creates an S3 gateway endpoint and associates it with a route table.

provider aws {
  region = aws.Region.ap_northeast_1
}

let vpc = aws.ec2.Vpc {
  cidr_block = '10.0.0.0/16'

  tags = {
    Environment = 'example'
  }
}

let route_table = aws.ec2.RouteTable {
  vpc_id = vpc.vpc_id

  tags = {
    Environment = 'example'
  }
}

aws.ec2.VpcEndpoint {
  vpc_id            = vpc.vpc_id
  service_name      = 'com.amazonaws.ap-northeast-1.s3'
  vpc_endpoint_type = aws.ec2.VpcEndpoint.VpcEndpointType.gateway
  route_table_ids   = [route_table.route_table_id]

  tags = {
    Environment = 'example'
  }
}
