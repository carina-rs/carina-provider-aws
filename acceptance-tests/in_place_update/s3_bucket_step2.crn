# S3 Bucket - in-place update test (step 2)
#
# Tests: update standalone BucketVersioning from Enabled to Suspended
# (in-place update on the BucketVersioning resource).

provider aws {
  region = aws.Region.ap_northeast_1
}

let bucket = aws.s3.Bucket {
  bucket = 'carina-acc-test-aws-s3-update'

  tags = {
    Environment = 'acceptance-test'
  }
}

aws.s3.BucketVersioning {
  bucket = bucket.bucket
  status = aws.s3.BucketVersioning.VersioningStatus.Suspended
}
