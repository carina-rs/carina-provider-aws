# EC2 VPC - create_before_destroy conflict test (step 1: initial)
#
# Seeds a stable, let-bound VPC for the step-2 replacement attempt. ec2.Vpc is
# Conflicting because not every combination of create-only changes can coexist;
# step 2 verifies that create_before_destroy is rejected at plan time.

provider aws {
  region = aws.Region.ap_northeast_1
}

let cbd_vpc = aws.ec2.Vpc {
  cidr_block           = '10.200.0.0/16'
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name        = 'carina-acc-test-cbd-vpc'
    Environment = 'acceptance-test'
  }
}
