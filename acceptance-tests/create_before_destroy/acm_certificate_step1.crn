# ACM Certificate - dependent-promoted create_before_destroy replacement
#
# The validation records depend on cert, so changing create-only key_algorithm
# in step 2 promotes its replacement to create_before_destroy without a directive.
# Certificates are Coexisting since #649: each initial create uses a fresh
# ClientToken, and certificates for the same domain share the validation CNAME.
# We do not own this domain or delegate this public zone, so validation never
# completes and the certificate remains PENDING_VALIDATION.

provider aws {
  region = aws.Region.ap_northeast_1
}

provider awscc {
  region = aws.Region.ap_northeast_1
}

let zone = awscc.route53.HostedZone {
  name = 'carina-acc-test-cbd-acm.carina-rs-test.com.'

  hosted_zone_config = {
    comment = 'Carina create_before_destroy ACM acceptance test zone'
  }

  hosted_zone_tags = [
    {
      key   = 'Environment'
      value = 'acceptance-test'
    },
  ]
}

let cert = aws.acm.Certificate {
  domain_name       = 'carina-acc-test-cbd-acm.carina-rs-test.com'
  validation_method = aws.acm.Certificate.ValidationMethod.dns
  key_algorithm     = aws.acm.Certificate.KeyAlgorithm.rsa_2048

  tags = {
    Environment = 'acceptance-test'
  }
}

let validation_records = for opt in cert.domain_validation_options {
  aws.route53.RecordSet {
    hosted_zone_id   = zone.id
    name             = opt.resource_record.name
    type             = aws.route53.RecordSet.Type.cname
    ttl              = 300
    resource_records = [opt.resource_record.value]
  }
}
