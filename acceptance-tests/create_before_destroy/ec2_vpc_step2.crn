# EC2 VPC - create_before_destroy conflict test (step 2: reject replacement)
#
# Changes cidr_block (create-only) with create_before_destroy lifecycle while
# keeping the same let binding as step 1. ec2.Vpc is Conflicting, so planning
# rejects create_before_destroy before making any AWS request.

provider aws {
  region = aws.Region.ap_northeast_1
}

let cbd_vpc = aws.ec2.Vpc {
  cidr_block           = '10.201.0.0/16'
  enable_dns_support   = true
  enable_dns_hostnames = true

  directives {
    create_before_destroy = true
  }

  tags = {
    Name        = 'carina-acc-test-cbd-vpc'
    Environment = 'acceptance-test'
  }
}
