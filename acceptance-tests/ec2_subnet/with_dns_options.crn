# EC2 Subnet - DNS options test
#
# Tests: private_dns_name_options_on_launch (Struct type)

provider aws {
  region = aws.Region.ap_northeast_1
}

let vpc = aws.ec2.Vpc {
  cidr_block           = '10.0.0.0/16'
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Environment = 'acceptance-test'
  }
}

aws.ec2.Subnet {
  vpc_id            = vpc.vpc_id
  cidr_block        = '10.0.1.0/24'
  availability_zone = aws.AvailabilityZone.ZoneName.ap_northeast_1a

  private_dns_name_options_on_launch = {
    enable_resource_name_dns_a_record = true
    hostname_type                     = aws.ec2.Subnet.PrivateDnsNameOptionsOnLaunch.HostnameType.ip_name
  }

  tags = {
    Environment = 'acceptance-test'
  }
}
