# S3 Bucket - Basic test
#
# Tests: bucket creation with name + tags. Versioning is now a separate
# resource (s3_bucket_versioning).

provider aws {
  region = aws.Region.ap_northeast_1
}

aws.s3.Bucket {
  bucket = 'carina-acc-test-aws-s3-basic-v2'

  tags = {
    Environment = 'acceptance-test'
  }
}
