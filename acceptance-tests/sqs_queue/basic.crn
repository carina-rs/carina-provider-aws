# SQS Queue - Basic test
#
# Tests: standard queue creation covering policy (IAM-shaped struct),
# numeric knobs, long-polling, SSE-SQS, and tags.

provider aws {
  region = aws.Region.ap_northeast_1
}

aws.sqs.Queue {
  queue_name                          = 'carina-acc-test-aws-sqs-queue-basic-v1'
  visibility_timeout                  = 60
  message_retention_period            = 86400
  delay_seconds                       = 0
  maximum_message_size                = 262144
  receive_message_wait_time_seconds   = 20
  sqs_managed_sse_enabled             = true

  policy = {
    version = aws.iam.PolicyDocument.Version.2012_10_17
    statement = [
      {
        sid    = 'AllowSelf'
        effect = aws.iam.PolicyDocument.Effect.allow
        principal = {
          aws = ['*']
        }
        action   = ['sqs:SendMessage']
        resource = ['*']
      },
    ]
  }

  tags = {
    Environment = 'acceptance-test'
  }
}
