# S3 BucketVersioning - Basic test
#
# Tests: standalone aws.s3.BucketVersioning enabling versioning on a bucket.

provider aws {
  region = aws.Region.ap_northeast_1
}

let bucket = aws.s3.Bucket {
  bucket = 'carina-acc-test-aws-s3-bucket-versioning-basic-v1'
}

aws.s3.BucketVersioning {
  bucket = bucket.bucket
  status = aws.s3.BucketVersioning.VersioningStatus.Enabled
}
